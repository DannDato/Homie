{
  "name": "homie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Asistente personal privado con Telegram y Ollama local",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx src/scripts/migrate.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "grammy": "^1.35.1",
    "luxon": "^3.5.0",
    "pino": "^9.6.0",
    "zod": "^3.24.2",
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "@types/better-sqlite3": "^7.6.13"
  }
}
