# Telegram: crea un bot en @BotFather
TELEGRAM_BOT_TOKEN=REEMPLAZAR_CON_TOKEN_REAL
# Único propietario; los demás se autorizan desde Telegram.
ADMIN_TELEGRAM_USER_ID=0

TZ=America/Mexico_City
SQLITE_PATH=./data/asistente.db

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Opcional: usar similitud semantica (requiere ollama pull nomic-embed-text)
SEMANTIC_MATCHING=false
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.3

HISTORY_MESSAGES=10
SUMMARY_EVERY_N_MESSAGES=12
MAX_TOOL_ITERATIONS=5

DAILY_SUMMARY_TIME=08:00
DEFAULT_REMINDER_TIME=09:00
REMINDER_LEAD_MINUTES=30
QUIET_HOURS=22:00-07:00
SCHEDULER_INTERVAL_SECONDS=60
